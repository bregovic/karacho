generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  password      String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Song {
  id            String    @id @default(cuid())
  title         String
  genre         String?
  tags          String[]
  year          Int?
  lyrics        String?
  chords        String?
  maxBlockChars Int       @default(40)
  playCount     Int       @default(0)
  rating        Float     @default(0.0)
  state         SongState @default(NEW)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  artist        String?
  audioUrl      String?
  instrumentalUrl String?
  backgroundUrl String?
  jsonUrl       String?
  videoUrl      String?
  videoSize     Int?
  animationStyle String   @default("karaoke-classic")
  timingData    Json?
  tracks        Track[]
  sessions      KaraokeSession[] @relation("CurrentSong")
  queueItems    KaraokeSessionQueue[]
}

model Track {
  id         String   @id @default(cuid())
  name       String
  url        String
  timingData Json?
  songId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model KaraokeSession {
  id            String    @id @default(cuid())
  joinCode      String    @unique // Krátký kód pro mobil (např. ABC1)
  status        SessionStatus @default(STOPPED)
  currentSongId String?
  currentTime   Float     @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  currentSong   Song?     @relation("CurrentSong", fields: [currentSongId], references: [id])
  queue         KaraokeSessionQueue[]
}

model KaraokeSessionQueue {
  id        String   @id @default(cuid())
  sessionId String
  songId    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  session   KaraokeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
}

enum SessionStatus {
  PLAYING
  PAUSED
  STOPPED
}

enum Role {
  USER
  ADMIN
}

enum SongState {
  NEW
  PENDING_TIMING
  ANIMATION
  TESTING
  ACTIVE
}

model AdminEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
